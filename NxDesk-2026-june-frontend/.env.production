# Overrides .env for `npm run build` specifically (Create React App loads
# .env first, then layers .env.production on top for production builds) -
# this exists so a locally-testing REACT_APP_BASE_API_URL in the shared
# .env file (e.g. http://localhost:8000) can never again reach a real
# production build, regardless of what .env happens to contain when
# someone commits it.
REACT_APP_BASE_API_URL=https://nxdesk.in
